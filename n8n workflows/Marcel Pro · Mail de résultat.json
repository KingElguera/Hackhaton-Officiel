    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Adresse du site de Jade\nconst URL_SITE = 'https://marcel-front.vercel.app';\nconst b = $json.body ?? $json;\nconst rec = b.record ?? {};\nconst old = b.old_record ?? {};\nconst vientDeTerminer = rec.statut === 'termine' && (b.type === 'INSERT' || (b.type === 'UPDATE' && old.statut !== 'termine'));\nlet etape = 'ignorer';\nlet erreur = null;\nif (vientDeTerminer) {\n  if (rec.email_artisan) {\n    etape = 'envoyer';\n  } else {\n    etape = 'sans_email';\n    erreur = \"email_artisan manquant dans la table projets\";\n  }\n}\nconst h = '0123456789abcdef';\nlet u = '';\nfor (let i = 0; i < 36; i++) {\n  if ([8, 13, 18, 23].includes(i)) { u += '-'; continue; }\n  if (i === 14) { u += '4'; continue; }\n  let r = Math.floor(Math.random() * 16);\n  if (i === 19) r = (r & 0x3) | 0x8;\n  u += h[r];\n}\nconst nom = rec.nom || rec.nom_chantier || null;\nreturn {\n  json: {\n    etape,\n    erreur,\n    debut_ms: Date.now(),\n    passage_id: u,\n    projet_id: rec.id ?? null,\n    email: rec.email_artisan ?? null,\n    prenom: rec.prenom_artisan || '',\n    nom_chantier: nom,\n    lien: URL_SITE + '/chantiers/' + (rec.id ?? '')\n  }\n};\n"
      },
